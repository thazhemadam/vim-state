{
  "name": "pi-vim",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Vim-style modal editing integration for Pi.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "vim",
    "modal-editing"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
