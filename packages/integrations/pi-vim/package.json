  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "vim-state": "0.1.0",
    "xstate": "5.32.1"
  },
  "devDependencies": {
    "oxlint": "^1.70.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
