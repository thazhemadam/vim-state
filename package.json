{
  "name": "vim-pi",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable Vim modal state machine with a Pi editor adapter.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "vim",
    "modal-editing",
    "state-machine",
    "xstate"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "dev:pi": "PI_CODING_AGENT_DIR=$PWD/.pi-dev/agent PI_CODING_AGENT_SESSION_DIR=$PWD/.pi-dev/sessions pi --no-extensions -e .",
    "dev:pi:clean": "rm -rf .pi-dev"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "xstate": "5.32.1"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
